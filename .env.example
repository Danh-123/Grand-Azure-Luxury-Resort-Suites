# ==============================================================================
# GRAND AZURE LUXURY RESORT & SUITES - ENVIRONMENT VARIABLES
# ==============================================================================
# Sao chép file này thành .env.local và điền các giá trị thực tế của bạn
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT NOTIFICATIONS (Miễn phí 0đ trọn đời)
# ------------------------------------------------------------------------------
# HƯỚNG DẪN LẤY TOKEN & CHAT ID:
# 1. Mở Telegram, tìm kiếm bot tên "@BotFather", gửi lệnh: /newbot
# 2. Đặt tên hiển thị và username cho bot -> Bạn sẽ nhận được chuỗi API Token
# 3. Để lấy Chat ID cá nhân: tìm kiếm bot "@userinfobot" và bấm Start -> copy ID
#    (Hoặc nếu muốn gửi vào Nhóm lễ tân: Thêm bot vào nhóm và lấy Group Chat ID)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="123456789"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (Miễn phí 100% - 500MB Database)
# ------------------------------------------------------------------------------
# HƯỚNG DẪN LẤY THÔNG TIN TỪ SUPABASE:
# 1. Truy cập https://supabase.com -> Đăng nhập bằng GitHub -> Tạo Project mới
# 2. Vào Project Settings -> API:
#    - Project URL copy vào NEXT_PUBLIC_SUPABASE_URL
#    - anon / public key copy vào NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role key copy vào SUPABASE_SERVICE_ROLE_KEY
# 3. Vào SQL Editor trên Supabase -> Dán toàn bộ nội dung file `supabase/schema.sql` và bấm RUN
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Connection String PostgreSQL nếu dùng Prisma hoặc kết nối trực tiếp
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. NEXT.JS APP CONFIG
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

